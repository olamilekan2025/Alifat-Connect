
{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "target": "ES2020",
  "module": "Node16",
"moduleResolution": "Node16",
    "outDir": "./dist",
    "rootDir": "..",
    "noEmit": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
"include": [
  "src/**/*.ts"
],
  "exclude": [
    "node_modules",
    "dist",
    "../node_modules",
    "../.next"
  ]
}
